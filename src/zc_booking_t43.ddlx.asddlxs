@Metadata.layer: #CORE

@UI.chart: [{ qualifier: 'PriceBullet',
              title: 'Price Chart',
              chartType: #BULLET,
              measures: ['TotalPrice'],
              measureAttributes: [{ measure: 'TotalPrice',
                                    role: #AXIS_1,
                                    asDataPoint: true }] }]

// T01 - Object Page header: title area of the detail page.
// 'imageUrl' could point to an element containing a picture URL (see T16 note).
@UI.headerInfo: {
  typeName:       'Booking',
  typeNamePlural: 'Bookings',
  typeImageUrl:   'sap-icon://activity-items',
  title:       { type: #STANDARD, value: 'BookingId' },
  description: { type: #STANDARD, value: 'Description' }
}

@Search.searchable: true
annotate entity ZC_BOOKING_T43
    with 
{
    @UI.facet: [
    { 
        id: 'General',   
        purpose: #STANDARD, 
        type: #COLLECTION,
        label: 'General Information', 
        position: 10 
    },
    { 
        id: 'Items',
        purpose: #STANDARD, 
        type: #LINEITEM_REFERENCE,
        label: 'Items', 
        position: 20,
        targetElement: '_bookingItem'
    },
    { 
        id: 'BasicData',   
        parentId: 'General',
        type: #FIELDGROUP_REFERENCE,
        targetQualifier: 'BasicData',
        label: 'Basic Data', 
        position: 10 
    },
    { 
        id: 'PriceData',   
        parentId: 'General',
        type: #FIELDGROUP_REFERENCE,
        targetQualifier: 'PriceData',
        label: 'Frice Data', 
        position: 20 
    },
    { 
        id: 'HeaderFrice',
        purpose: #HEADER,
        type: #DATAPOINT_REFERENCE,
        targetQualifier: 'FriceDP',
        label: 'Total Frice', 
        position: 10 
    },
    { 
        id: 'HeaderStatus',
        purpose: #HEADER,
        type: #DATAPOINT_REFERENCE,
        targetQualifier: 'StatusDP',
        label: 'Status', 
        position: 20 
    },
    { 
        id: 'CustomerInfo',
        purpose: #HEADER,
        type: #FIELDGROUP_REFERENCE,
        targetQualifier: 'CustomerInfo',
        label: 'Customer Information', 
        position: 30 
    }
    ]

    @EndUserText.label: 'Booking ID'
    @UI.lineItem:       [{ position: 10, importance: #HIGH }]       // List Report
    @UI.identification: [{ position: 10 }]                          // Field Object Page
//    @UI.selectionField: [{ position: 10 }]                          // Filterbar
    @UI.fieldGroup:     [{ qualifier: 'BasicData', position: 10 }]
    @Search.defaultSearchElement: true                              // tham gia search
    @Search.fuzzinessThreshold: 0.8
    BookingId;
    
    @EndUserText.label: 'Customer'
    @UI.lineItem:       [{ position: 20, importance: #HIGH }]
    @UI.fieldGroup:     [{ qualifier: 'BasicData', position: 10 }, { qualifier: 'CustomerInfo', position: 10 }]
    @UI.selectionField: [{ position: 20 }]
    @Consumption.valueHelpDefinition: [{ 
        entity              : { name: 'ZI_CUSTOMER_TNV43', element: 'CustomerId' },
        useForValidation    : true,
        additionalBinding   : [{ 
            localElement: 'CustomerCity', 
            element: 'City',
            usage: #FILTER
        }]
    }]
    @Consumption.filter.selectionType: #SINGLE
    @UI.textArrangement: #TEXT_FIRST
    CustomerId;
    
    @EndUserText.label: 'E-Mail Address'
    @UI.fieldGroup:     [{ qualifier: 'CustomerInfo', position: 20 }]
    CustomerEmail;
    
    @EndUserText.label: 'City'
    @UI.fieldGroup:     [{ qualifier: 'CustomerInfo', position: 30 }]
    @UI.selectionField: [{ position: 35 }]
    @Consumption.valueHelpDefinition: [{ 
        entity: { name: 'ZI_CITY_VH_TNV43', element: 'City' }
    }]
    CustomerCity;
    
    @EndUserText.label: 'Booking Date'
    @UI.lineItem:       [{ position: 30, importance: #HIGH }]
    @UI.fieldGroup:     [{ qualifier: 'BasicData', position: 20 }]
    @UI.selectionField: [{ position: 30 }]
    @Consumption.filter.selectionType: #INTERVAL
    BookingDate;
    
    @EndUserText.label: 'Total Price'
    @UI.lineItem:       [{ position: 40, importance: #HIGH }]
    @UI.fieldGroup:     [{ qualifier: 'PriceData', position: 10 }]
    @UI.dataPoint:      { qualifier: 'PriceDP', 
                          title: 'Total Price',
                          targetValue: 1000,
                          minimumValue: 0,
                          criticalityCalculation: {
                              improvementDirection: #TARGET,
                              deviationRangeLowValue: 300,
                              toleranceRangeLowValue: 500,
                              toleranceRangeHighValue: 1000,
                              deviationRangeHighValue: 1200
                          } }
    TotalPrice;

    @EndUserText.label: 'Currency'
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CurrencyStdVH', element: 'Currency' }}]
    @UI.fieldGroup:     [{ qualifier: 'PriceData', position: 20 }]
    @UI.lineItem:       [{ position: 42, 
                           type: #AS_CHART,
                           valueQualifier: 'PriceBullet',
                           label: 'Price Chart' }]
    CurrencyCode;
    
    @EndUserText.label: 'Priority'
    @UI.lineItem:       [{ position: 45, 
                           importance: #HIGH,
                           criticality: 'PriorityCriticality',
                           criticalityRepresentation: #WITH_ICON }]
    @UI.identification: [{ position: 45 }]
    @UI.selectionField: [{ position: 60 }]
    @Consumption.valueHelpDefinition: [{ 
        entity: { name: 'ZI_PRIORITY_VH_TNV43', element: 'Priority' },
        useForValidation: true 
    }]
    Priority;
    
    @UI.hidden: true
    PriorityCriticality;
    
    @EndUserText.label: 'Status'
    @UI.lineItem:       [{ position: 50, 
                           importance: #HIGH,
                           criticality: 'StatusCriticality' }]
    @UI.identification: [{ position: 50 }]
    @UI.selectionField: [{ position: 40 }]
    @UI.textArrangement: #TEXT_ONLY
    OverallStatus;
    
    @EndUserText.label: 'Confirmed'
    @UI.lineItem:       [{ position: 55, importance: #HIGH }]
    @UI.identification: [{ position: 55 }]
    @UI.selectionField: [{ position: 50 }]
    @UI.fieldGroup:     [{ qualifier: 'BasicData', position: 45 }]
    @Consumption.valueHelpDefinition: [{ 
        entity: { name: 'ZI_CONFIRM_VH_TNV43', element: 'ConfirmFlag' },
        useForValidation: true 
    }]
    @UI.textArrangement: #TEXT_ONLY
    ConfirmFlag;
    
    @UI.hidden: true
    StatusCriticality;
    
    @EndUserText.label: 'Rating'
    @UI.lineItem:       [{ position: 60, 
                           importance: #HIGH,
                           type: #AS_DATAPOINT }]
    @UI.dataPoint:      { title: 'Customer Rating',
                          targetValue: 5,
                          visualization: #RATING }
    CustomerRating;
    
    @EndUserText.label: 'Completion'
    @UI.lineItem:       [{ position: 65, 
                           importance: #HIGH,
                           type: #AS_DATAPOINT }]
    @UI.dataPoint:      { title: 'Completion',
                          targetValue: 100,
                          visualization: #PROGRESS }
    CompletionPct;
    
    @EndUserText.label: 'Contact'
    @UI.lineItem:       [{ position: 70, importance: #HIGH }]
    @UI.fieldGroup:     [{ qualifier: 'CustomerInfo', position: 5 }]
    CustomerName;
    
    @EndUserText.label: 'Description'
    @UI.lineItem:       [{ position: 80, importance: #HIGH }]
    @UI.fieldGroup:     [{ qualifier: 'BasicData', position: 40 }]
    Description;
}